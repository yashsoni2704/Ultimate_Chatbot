GOOGLE_API_KEY=your_google_api_key_here
UPLOAD_FOLDER=uploads
VECTOR_DB_PATH=vector_store

# ──────────────────────────────────────
# Qdrant Vector Store
# ──────────────────────────────────────
QDRANT_PATH=vector_store
QDRANT_COLLECTION_NAME=docmind

CHUNK_SIZE=2000
CHUNK_OVERLAP=500

TOP_K=30
SCORE_THRESHOLD=0.3

# ──────────────────────────────────────
# Reranker
# RERANKER_ENABLED: True to rerank retrieved chunks before sending to LLM
# RERANKER_MODEL:   HuggingFace model id for the reranker
# RERANKER_TOP_N:   How many chunks to keep after reranking
# ──────────────────────────────────────
RERANKER_ENABLED=True
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_TOP_N=10

EMBEDDING_MODEL=bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8

# ──────────────────────────────────────
# Primary LLM (default model)
# ──────────────────────────────────────
LLM_PROVIDER=google
LLM_MODEL=llama3.1:latest
LLM_TEMPERATURE=0.2

# ──────────────────────────────────────
# Secondary LLM (fallback when user is unsatisfied)
# ──────────────────────────────────────
SECONDARY_LLM_PROVIDER=ollama
SECONDARY_LLM_MODEL=mistral:7b-instruct
SECONDARY_LLM_TEMPERATURE=0.2

# ──────────────────────────────────────
# Google Gemini (only used when LLM_PROVIDER=google)
# Models: gemini-1.5-flash | gemini-1.5-pro | gemini-2.0-flash
# ──────────────────────────────────────
GOOGLE_LLM_MODEL=gemini-2.0-flash

# ──────────────────────────────────────
# Satisfaction Check Settings
# Ask user satisfaction after every N questions (0 = disabled)
# ──────────────────────────────────────
SATISFACTION_CHECK_INTERVAL=3
SUPPORT_EMAIL=your_support_email@example.com

# ──────────────────────────────────────
# Conversation History
# Set True  → last N turns are sent to the LLM for context
# Set False → every question is answered independently
# ──────────────────────────────────────
CONVERSATION_HISTORY=True
CONVERSATION_HISTORY_LIMIT=3

# ──────────────────────────────────────
# Web Scraping (Playwright)
# Increase SCRAPING_TIMEOUT for slow/JS-heavy sites
# ──────────────────────────────────────
SCRAPING_TIMEOUT=70
SCRAPING_MIN_CHARS=1
SCRAPING_MAX_CHARS=10000000

# ──────────────────────────────────────
# LangSmith Tracing (optional)
# Get your API key from https://smith.langchain.com/
# Set LANGCHAIN_TRACING_V2=true to enable tracing
# ──────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=docmind-chatbot

# ──────────────────────────────────────
# Admin Panel Auth (HTTP Basic Auth)
# Set both to protect the /admin panel
# Leave blank to disable auth (dev only)
# ──────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here

# ──────────────────────────────────────
# MongoDB
# ──────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=Ultimate_Chatbot

# ──────────────────────────────────────
# Mic Voice Input
# Seconds of silence before mic auto-closes (default: 3)
# ──────────────────────────────────────
MIC_SILENCE_TIMEOUT=3

# ──────────────────────────────────────
# Speech-to-Text (STT)
# Default provider: assemblyai | deepgram | faster_whisper | vosk | windows_sapi
# ──────────────────────────────────────
STT_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here
VOSK_MODEL_PATH=models/vosk-model-small-en-us
FASTER_WHISPER_MODEL=base
